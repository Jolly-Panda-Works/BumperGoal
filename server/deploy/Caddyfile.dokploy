# HTTP edge behind Dokploy's HTTPS reverse proxy. No competing ACME listener.
{
	auto_https off
}
:80 {
	encode zstd gzip
	header -Server
	handle /healthz {
		respond "ok" 200
	}
	@api host {$API_DOMAIN}
	handle @api {
		reverse_proxy flickkick-nakama:7350
	}
	handle {
		root * /srv
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://{$API_DOMAIN} wss://{$API_DOMAIN} {$VOICE_CONNECT_SRC}; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		}
		@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|wasm)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Exported art and audio keep their names across releases, so they only get a week.
		@art {
			path /assets/*
			not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|wasm)$
		}
		header @art Cache-Control "public, max-age=604800"
		@entry path / /index.html
		header @entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
