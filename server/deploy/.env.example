# Copy to server/deploy/.env and replace every value. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
# Public client key (also set as VITE_NAKAMA_SERVER_KEY for the web build). Not a secret, but do not reuse "defaultkey".
NAKAMA_SERVER_KEY=change-me-client-key
# Secrets: long random strings (e.g. openssl rand -hex 32).
NAKAMA_SESSION_KEY=change-me-session-encryption-key
NAKAMA_REFRESH_KEY=change-me-refresh-encryption-key
NAKAMA_HTTP_KEY=change-me-runtime-http-key
NAKAMA_CONSOLE_PASSWORD=change-me-console-password
# Bind address for published ports (127.0.0.1 locally; 0.0.0.0 behind a firewall/reverse proxy in production).
NAKAMA_BIND=127.0.0.1
# Matchmaking bot fallback. Production default 10000; lower it only for local testing.
MM_BOT_TIMEOUT_MS=10000
# Server bot search budget per decision (wazero interpreter: ~200 ms per prediction).
AI_SERVER_MAX_SIMULATIONS=12
# Balance admin panel at /admin. Server-side only; leave empty to disable. Password: 12+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Voice chat (comms game rooms). Leave empty to play without voice. The server key and the
# webhook secret come from the comms app (see docs/VOICE_CHAT.md); never put them in the web build.
COMMS_URL=
COMMS_SERVER_KEY=
COMMS_WEBHOOK_SECRET=
