# Production settings. Create the real file with: ./server/deploy/gen-secrets.sh
# (it copies this template to .env.prod and fills every secret). Never commit .env.prod.

# --- Domains (DNS A/AAAA records must point at this server before the first start) ---
WEB_DOMAIN=play.example.com
API_DOMAIN=api.play.example.com
ACME_EMAIL=ops@example.com

# --- Database (Dokploy: the internal host, name and user of its PostgreSQL service) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nakama
DB_USER=nakama

# --- Secrets (generated) ---
POSTGRES_PASSWORD=
# Public client key (embedded in the web build). Generated, but not a secret.
NAKAMA_SERVER_KEY=
NAKAMA_SESSION_KEY=
NAKAMA_REFRESH_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=

# --- Balance admin panel (https://WEB_DOMAIN/admin) ---
# Server-side only, never in the web build. Leave either empty to disable the panel;
# the password needs at least 12 characters (gen-secrets.sh generates one).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Voice chat (comms game rooms, docs/VOICE_CHAT.md) ---
# Empty COMMS_URL / COMMS_SERVER_KEY: matches play without voice.
# COMMS_URL is how Nakama reaches comms; COMMS_PUBLIC_URL is the address browsers use (baked into the web build).
COMMS_URL=
COMMS_SERVER_KEY=
COMMS_WEBHOOK_SECRET=
COMMS_PUBLIC_URL=
# Extra CSP connect-src origins: comms and its LiveKit server, e.g. "https://comms.example.com wss://media.example.com"
VOICE_CONNECT_SRC=

# --- Gameplay ---
MM_BOT_TIMEOUT_MS=10000
AI_SERVER_MAX_SIMULATIONS=12

# --- Operations ---
RELEASE_TAG=latest
NAKAMA_CPUS=2
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
