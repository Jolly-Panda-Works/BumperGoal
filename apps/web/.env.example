# Copy to .env.local (dev) or set in the build environment.
# Leave VITE_NAKAMA_HOST empty to build an offline-only client.
VITE_NAKAMA_HOST=127.0.0.1
VITE_NAKAMA_PORT=7350
VITE_NAKAMA_SSL=false
# Must equal NAKAMA_SERVER_KEY in server/deploy/.env (public client key).
VITE_NAKAMA_SERVER_KEY=
# comms public URL for in-match voice chat; empty builds a client without voice.
VITE_COMMS_URL=
